# 1. Credenciais Base (Fonte da verdade)
# O Docker Compose vai ler isso para configurar o banco de dados
POSTGRES_USER=golden_user
POSTGRES_PASSWORD=golden_password123
POSTGRES_DB=pokemon_golden_age
POSTGRES_PORT=5432

# 2. Conexão Externa / Local (Para a sua máquina física)
# Usado APENAS quando você roda `npx prisma studio` ou migrations localmente.
# Note que aqui usamos 'localhost' porque sua máquina acessa a porta exposta pelo Docker.
DATABASE_URL=postgresql://golden_user:golden_password123@localhost:5432/pokemon_golden_age?schema=public

# 3. Configurações da Aplicação
PORT=3001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=super_secret_key_change_in_production